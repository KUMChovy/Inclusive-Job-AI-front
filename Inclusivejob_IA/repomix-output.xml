          className="sm:w-72"
        />
        <FilterTabs options={FILTROS} value={filtro} onChange={(v) => { setFiltro(v); reset(); }} />
        <Select
          value={modalidad}
          onChange={(v) => { setModalidad(v); reset(); }}
          options={MODALIDADES}
          className="sm:w-48"
        />
      </div>

      <Table columns={COLS} data={paginated} loading={false} emptyMessage="No se encontraron vacantes." caption="Vacantes registradas" />
      <Pagination total={filtered.length} page={page} limit={LIMIT} onPageChange={goToPage} />

      <Modal open={modal.open} onClose={closeModal} title={mc.title}>
        <p className="text-slate-300 text-sm">
          Vas a <strong className="text-white">{mc.label.toLowerCase()}</strong> la vacante{' '}
          <strong className="text-white">"{modal.vacante?.titulo}"</strong>.
        </p>
        <p className="text-slate-400 text-sm mt-2">{mc.msg}</p>
        <ModalFooter>
          <Button variant="ghost" onClick={closeModal}>Cancelar</Button>
          <Button variant={mc.variant} loading={actionLoading} onClick={handleAction}>{mc.label}</Button>
        </ModalFooter>
      </Modal>
    </div>
  );
}
</file>

