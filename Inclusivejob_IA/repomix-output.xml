// src/pages/Admin/Discapacidades.jsx
import { useState } from 'react';
import { Plus, Pencil, Trash2, Accessibility } from 'lucide-react';
import { PageHeader, Button, ErrorBanner } from '../../assets/Componentes/Admin/UI';
import Table from '../../assets/Componentes/Admin/Table';
import Modal, { ModalFooter } from '../../assets/Componentes/Admin/Modal';

const MOCK_DISCAPACIDADES = [
  { id: 1, nombre: 'Visual', descripcion: 'Pérdida total o parcial de la visión. Incluye ceguera y baja visión.' },
  { id: 2, nombre: 'Auditiva', descripcion: 'Pérdida total o parcial de la audición. Incluye sordera y hipoacusia.' },
  { id: 3, nombre: 'Motriz', descripcion: 'Limitación en el movimiento y control del cuerpo o extremidades.' },
  { id: 4, nombre: 'Intelectual', descripcion: 'Dificultades significativas en el aprendizaje, comunicación y habilidades sociales.' },
  { id: 5, nombre: 'Psicosocial', descripcion: 'Condiciones de salud mental que afectan el funcionamiento social y laboral.' },
];

const EMPTY_FORM = { nombre: '', descripcion: '' };

export default function Discapacidades() {
  const [discapacidades, setDiscapacidades] = useState(MOCK_DISCAPACIDADES);
  const [modal, setModal] = useState({ open: false, type: null, item: null });
  const [form, setForm] = useState(EMPTY_FORM);
  const [formError, setFormError] = useState('');
  const [actionLoading, setActionLoading] = useState(false);

  const openCreate = () => {
    setForm(EMPTY_FORM);
    setFormError('');
    setModal({ open: true, type: 'crear', item: null });
  };

  const openEdit = (item) => {
    setForm({ nombre: item.nombre, descripcion: item.descripcion });
    setFormError('');
    setModal({ open: true, type: 'editar', item });
  };

  const openDelete = (item) => {
    setModal({ open: true, type: 'eliminar', item });
  };

  const closeModal = () => {
    setModal({ open: false, type: null, item: null });
    setFormError('');
  };

  const handleSave = async () => {
    if (!form.nombre.trim()) { setFormError('El nombre es obligatorio.'); return; }
    if (!form.descripcion.trim()) { setFormError('La descripción es obligatoria.'); return; }
    setActionLoading(true);
    try {
      // En producción: llamar API
      if (modal.type === 'crear') {
        const newItem = { id: Date.now(), ...form };
        setDiscapacidades((prev) => [...prev, newItem]);
      } else {
        setDiscapacidades((prev) =>
          prev.map((d) => d.id === modal.item.id ? { ...d, ...form } : d)
        );
      }
      closeModal();
    } finally {
      setActionLoading(false);
    }
  };

  const handleDelete = async () => {
    setActionLoading(true);
    try {
      setDiscapacidades((prev) => prev.filter((d) => d.id !== modal.item.id));
      closeModal();
    } finally {
      setActionLoading(false);
    }
  };

  const COLS = [
    { key: 'nombre', label: 'Nombre', render: (v) => <span className="text-white font-semibold">{v}</span> },
    { key: 'descripcion', label: 'Descripción' },
    {
      key: 'acciones', label: 'Acciones', render: (_, row) => (
        <div className="flex items-center gap-1">
          <Button variant="ghost" size="sm" onClick={() => openEdit(row)} aria-label="Editar">
            <Pencil size={14} />
          </Button>
          <Button variant="danger" size="sm" onClick={() => openDelete(row)} aria-label="Eliminar">
            <Trash2 size={14} />
          </Button>
        </div>
      )
    },
  ];

  return (
    <div className="space-y-5">
      <PageHeader
        title="Catálogo de Discapacidades"
        description="Administra los tipos de discapacidad disponibles en la plataforma"
        action={
          <Button variant="primary" size="sm" onClick={openCreate}>
            <Plus size={15} /> Nueva discapacidad
          </Button>
        }
      />

      <Table
        columns={COLS}
        data={discapacidades}
        emptyMessage="No hay tipos de discapacidad registrados."
        caption="Catálogo de tipos de discapacidad"
      />

      {/* Modal crear/editar */}
      <Modal
        open={modal.open && (modal.type === 'crear' || modal.type === 'editar')}
        onClose={closeModal}
        title={modal.type === 'crear' ? 'Nueva discapacidad' : 'Editar discapacidad'}
      >
        <ErrorBanner message={formError} />
        <div className="space-y-4">
          <div>
            <label className="block text-xs text-slate-400 mb-1.5" htmlFor="disc-nombre">
              Nombre <span className="text-red-400">*</span>
            </label>
            <input
              id="disc-nombre"
              type="text"
              value={form.nombre}
              onChange={(e) => setForm((f) => ({ ...f, nombre: e.target.value }))}
              placeholder="Ej: Visual, Auditiva..."
              className="w-full bg-slate-700 border border-slate-600 text-white text-sm rounded-lg px-3 py-2 outline-none focus:border-violet-500 transition-colors placeholder-slate-500"
            />
          </div>
          <div>
            <label className="block text-xs text-slate-400 mb-1.5" htmlFor="disc-desc">
              Descripción <span className="text-red-400">*</span>
            </label>
            <textarea
              id="disc-desc"
              value={form.descripcion}
              onChange={(e) => setForm((f) => ({ ...f, descripcion: e.target.value }))}
              placeholder="Describe brevemente este tipo de discapacidad..."
              rows={3}
              className="w-full bg-slate-700 border border-slate-600 text-white text-sm rounded-lg px-3 py-2 outline-none focus:border-violet-500 transition-colors placeholder-slate-500 resize-none"
            />
          </div>
        </div>
        <ModalFooter>
          <Button variant="ghost" onClick={closeModal}>Cancelar</Button>
          <Button variant="primary" loading={actionLoading} onClick={handleSave}>
            {modal.type === 'crear' ? 'Crear' : 'Guardar'}
          </Button>
        </ModalFooter>
      </Modal>

      {/* Modal eliminar */}
      <Modal open={modal.open && modal.type === 'eliminar'} onClose={closeModal} title="Eliminar discapacidad">
        <p className="text-slate-300 text-sm">
          ¿Estás seguro de que deseas eliminar <strong className="text-white">{modal.item?.nombre}</strong>?
        </p>
        <p className="text-slate-400 text-sm mt-2">
          Esta acción eliminará el tipo de discapacidad del catálogo y puede afectar a postulantes y vacantes relacionadas.
        </p>
        <ModalFooter>
          <Button variant="ghost" onClick={closeModal}>Cancelar</Button>
          <Button variant="danger" loading={actionLoading} onClick={handleDelete}>Eliminar</Button>
        </ModalFooter>
      </Modal>
    </div>
  );
}
</file>

