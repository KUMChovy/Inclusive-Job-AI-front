            px-3 py-1.5 text-sm rounded-md font-medium transition-all
            ${value === opt.value
              ? 'bg-violet-600 text-white shadow-lg shadow-violet-500/20'
              : 'text-slate-400 hover:text-white hover:bg-slate-700'
            }
          `}
        >
          {opt.label}
