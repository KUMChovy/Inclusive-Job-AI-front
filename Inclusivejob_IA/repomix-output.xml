        role="banner"
      >
        {/* Mobile hamburger */}
        <button
          onClick={onMobileMenuOpen}
          className="lg:hidden text-slate-400 hover:text-white p-1 rounded"
          aria-label="Abrir menú de navegación"
        >
          <Menu size={22} />
        </button>

        {/* Breadcrumbs */}
        <div className="hidden sm:flex flex-1">
          <Breadcrumbs />
