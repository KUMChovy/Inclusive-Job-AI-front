 *
 * columns: [{ key, label, render?, sortable?, className? }]
 * data: array de objetos
 * loading: boolean
 * emptyMessage: string
 * onSort: (key, dir) => void
 * sortKey, sortDir
 */
export default function Table({
  columns = [],
  data = [],
  loading = false,
  emptyMessage = 'No se encontraron registros.',
  onSort,
  sortKey,
  sortDir,
  caption,
